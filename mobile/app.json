{
  "expo": {
    "name": "HEARTLINK",
    "slug": "heartlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080C16",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#080C16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.heartlink.dating"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080C16"
      },
      "package": "com.heartlink.dating"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
