# HEARTLINK Environment Configuration

# JWT Secret for Session Encryption
JWT_SECRET=heartlink-ultra-secure-jwt-secret-key-2026

# Optional: Google Gemini API Key for Enhanced Conversational AI Cupid
# (When omitted, HeartLink uses its built-in advanced heuristic NLP engine)
GEMINI_API_KEY=

# Optional: PostgreSQL Connection String
# (When omitted, HeartLink uses its self-contained pure-JS database engine with zero external dependencies)
DATABASE_URL=

# Port
PORT=3000
